rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
// VOODO ERP — Firestore Security Rules (v2: real role enforcement)
//
// ⚠️ DEPLOYMENT ORDER MATTERS:
//   1. Owner account: shekovichy@gmail.com must exist in Firebase Auth
//      with a KNOWN password (it already exists in this project — reset
//      its password from the console if forgotten; deleting & re-adding
//      is also safe, the owner is recognized by email, not uid).
//   2. Deploy the client (merge to main) and confirm owner login works.
//   3. Publish these rules (test in Rules Playground first — see
//      CLAUDE.md). The owner is unaffected (email-based). Old
//      anonymous-auth clients stop working here, which is the goal.
//   4. ONLY AFTER these rules are live: create staff accounts from
//      "إدارة المستخدمين" and log each branch device in. (Staff
//      provisioning WRITES the roles collection, which the OLD rules
//      deny — so it cannot happen before this step.) Do steps 2→4 the
//      same day: in between, branch devices run local-only and their
//      sales stay on-device (addSale persists locally on write failure).
//
// Model:
//   roles/{uid} = { username, email, role: 'admin'|'manager'|'cashier',
//                   branchId } — created by an admin from the in-app
//   user management screen. No role doc → no access at all. The owner
//   email is admin regardless of any role doc (bootstrap, and safety
//   net if roles get corrupted).
//
// NOTE on structure: exists()/get() calls are inlined directly into each
// `allow` line instead of wrapped in a shared function. Wrapping them in a
// function (even with `database` passed as an explicit parameter) made the
// Rules Playground simulator fail with "Function not found error: [exists]"
// as soon as the call was actually reached (confirmed 2026-07-17 — it only
// LOOKED like it worked in cases where isOwner()/signedIn() short-circuited
// before exists() ran). Inlining is more verbose but is the pattern known
// to work reliably in this console.
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // Owner bootstrap — this exact account is always admin.
    //
    // email_verified matters here because the email address is the ONLY thing
    // identifying the owner (this account has no roles/{uid} document at all),
    // and an unverified address is not proof of control over it. The check was
    // deliberately absent until 2026-08-15 — the account really was unverified,
    // so adding it earlier would have locked the owner out of the entire system
    // the moment it was published.
    //
    // ⚠️ If the owner email is ever changed or the account recreated, verify it
    // BEFORE publishing rules that depend on this, and sign out and back in
    // afterwards: email_verified is read from the ID token, which keeps its old
    // value for up to an hour after the address is verified.
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'shekovichy@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // ── TAB PERMISSIONS (2026-07-19) ────────────────────────────────
    // Per-user view/write access per tab — see TAB_PERMISSIONS in
    // 00-core.js for the full picture (labels, which tabs are enforced
    // here vs UI-only, and why). Deliberately narrow: only mapped for
    // pos_data docs confirmed to have ZERO overlap with core POS/checkout/
    // cash-shift operations (customers, promos, inventory, sales,
    // suspended, and the pos_data/sessions doc are all read or written as
    // a routine part of completing a sale or opening/closing a drawer —
    // gating those here would lock a restricted cashier out of their own
    // job, not just a management page, since a Firestore rule can only
    // gate a whole document, not a UI page. Those stay on the OLD
    // unconditional "any role with a roles/ doc" behavior below, exactly
    // as before this feature existed).
    //
    // _tabOk takes an ALREADY-FETCHED roleData map, never calls get()/
    // exists() itself — wrapping get()/exists() inside a function (even
    // parameterized) broke the Rules Playground simulator (see the note at
    // the top of this file), so every get() stays inlined at the allow-line
    // call site and only the resulting *data* is passed in here.
    // No role=='admin' bypass here on purpose — 'admin' is just a label
    // since 2026-07-20, the real owner is the only unconditional bypass
    // (handled via isOwner() at every call site, not in here).
    function _tabOk(roleData, tab, action) {
      return !('permissions' in roleData)
        || (tab in roleData.permissions && roleData.permissions[tab][action] == true);
    }
    // pos_data/{doc} → the leaf permission key that doc's access is gated
    // by (2026-07-20: hr/purchases/expenses split into their real
    // sub-items — each already lives in its own document, so each gets
    // its own independent grant instead of one collapsed tab-wide key;
    // see DEPARTMENTS in 00-core.js for the full tree these keys belong
    // to). Docs not listed here (settings, accounts, customers,
    // promotions, sessions, suspended, price_approvals, ...) are untouched
    // by this system — see the long comment above. 'transfers' isn't in
    // this map on purpose: it is shared by BOTH the transfers and
    // warehouse tabs, handled as a special case at the call site instead
    // of a single-tab lookup.
    //
    // isTabGatedDoc()/tabForDoc() are a matched pair: 2026-07-25 Rules
    // Playground testing found `tabForDoc(doc) == null` unreliable as the
    // "is this doc gated at all" check — a missing map key can compare
    // unequal to `null` depending on the rules engine version, which was
    // silently denying access to ungated docs (customers, sessions,
    // suspended, promotions...) for any account with a non-empty
    // `permissions` map. `doc in {...}` membership is unambiguous, so it's
    // now the actual gate; tabForDoc() is only ever called after that
    // membership check has already passed.
    function isTabGatedDoc(doc) {
      return doc in {
        'pivot_favorites':   true,
        'suppliers':         true,
        'purchases':         true,
        'supplier_payments': true,
        'hr':                true,
        'attendance':        true,
        'payroll':           true,
        'leave_requests':    true,
        'expenses':          true,
        'expense_requests':  true,
        'audit':             true,
        'budgets':           true,
        'helpdesk':          true
      };
    }
    function tabForDoc(doc) {
      return {
        'pivot_favorites':   'customized',
        'suppliers':         'purchases_suppliers',
        'purchases':         'purchases_orders',
        'supplier_payments': 'purchases_payments',
        'hr':                'hr_targets',
        'attendance':        'hr_attendance',
        'payroll':           'hr_payroll',
        'leave_requests':    'hr_leaves',
        'expenses':          'expenses_main',
        'expense_requests':  'expenses_requests',
        'audit':             'audit',
        'budgets':           'accounting',
        'helpdesk':          'helpdesk'
      }[doc];
    }

    // ── ROLES — the permission source of truth ────────────────────
    // Users may read their own role (the app resolves it at login); ONLY
    // the real owner may list/create/update/delete roles or read someone
    // else's. 'admin' is just a label since 2026-07-20 (see
    // _defaultPermissionsFor in 00-core.js) — an admin-labeled account must
    // NOT be able to touch this collection, or it could edit its own (or
    // anyone else's) permissions map and grant itself whatever it wants,
    // defeating the entire point of the owner choosing each account's
    // access individually.
    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list, create, update, delete: if isOwner();
    }

    // ── POS DATA ──────────────────────────────────────────────────
    // 'auth' stays blocked outright (used to leak password hashes —
    // see CLAUDE.md). 'settings' and 'accounts' (legacy credential
    // doc) are admin-write-only; inv_* (legacy per-branch inventory docs —
    // see the branch-isolated replacement below) are admin-only entirely,
    // read included; everything else (suspended bills, customers,
    // transfers, approvals, audit, ...) is writable by any user WITH a
    // role, because cashier flows legitimately write them (suspend,
    // audit log, ...).
    match /pos_data/{doc} {
      allow read: if doc != 'auth' && !doc.matches('inv_.*') && (
        isOwner() ||
        (signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && (
          doc == 'transfers'
            ? (_tabOk(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data, 'transfers', 'view') ||
               _tabOk(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data, 'warehouse', 'view'))
            : (!isTabGatedDoc(doc) ||
               _tabOk(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data, tabForDoc(doc), 'view'))
        ))
      );
      allow write: if doc != 'auth' && !doc.matches('inv_.*') && (
        isOwner() ||
        (signedIn() &&
         exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
         // 'price_approvals' is the retired shared approvals document. Every
         // device moved to the per-request pos_price_approvals collection on
         // 2026-08-13 and nothing has written here since 2026-08-12 20:20.
         // Closing it means a client somehow still running the old build gets
         // a permission error instead of quietly filing a request into a
         // document no screen reads any more. Read stays open so the old
         // contents remain inspectable; delete it once you no longer care.
         !(doc in ['settings', 'accounts', 'budgets', 'price_approvals']) && (
           doc == 'transfers'
             ? (_tabOk(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data, 'transfers', 'write') ||
                _tabOk(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data, 'warehouse', 'write'))
             : (!isTabGatedDoc(doc) ||
                _tabOk(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data, tabForDoc(doc), 'write'))
         ))
      );
    }

    // ── LEGACY FLAT INVENTORY (pos_data/inv_b1, inv_wh, ...) ────────
    // Inventory migration (04-inventory-migration.js) confirmed run and
    // verified 2026-07-25 — no branch device or admin workflow reads this
    // path anymore. Owner-only now (was previously any 'admin'-role
    // account, kept open only for post-migration cleanup/verification);
    // narrowing this closes an unnecessary read/write surface on stale
    // data now that the branch-isolated replacement below is live.
    match /pos_data/{invDoc} {
      allow read, write: if invDoc.matches('inv_.*') && isOwner();
    }

    // ── INVENTORY — branch-isolated ─────────────────────────────────
    // Migration confirmed run and verified 2026-07-25 — this is the live
    // path every branch device reads/writes.
    // The 'wh' (warehouse) role additionally gets write access to EVERY
    // branch's inventory — not a gap, a real designed workflow: warehouse→
    // branch transfers write to the destination branch's stock (see
    // confirmWhTransfer in 95-warehouse.js / "وضع مخزن فقط" in
    // FEATURES.md). No role other than admin/wh ever needs cross-branch
    // inventory access, matching how the UI already gates transfers.
    match /pos_data/inventory/branches/{branchId} {
      allow read, write: if isOwner() || (
        signedIn() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.branchId == branchId ||
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.branchId == 'wh'
        )
      );
    }

    // ── SALES ────────────────────────────────────────────────────
    // Sales migration (03-sales-migration.js) confirmed run and verified —
    // every branch device reads exclusively from the branch-isolated
    // sub-collection below. This closes the gap the 2026-07-17 security
    // review flagged: Firestore rules can only allow/deny a whole document,
    // never filter which array elements a reader may see — so a shared
    // document mixing every branch's invoices could never be branch-isolated
    // no matter how the rule was written. Splitting storage by branch (see
    // addSale) is what makes real isolation possible at all.
    //
    // The old flat pos_sales/{month} doc (all branches mixed in one array)
    // is owner-only now (was previously any 'admin'-role account, kept open
    // only for post-migration cleanup/verification) — narrowing this closes
    // an unnecessary read/write surface on stale data now that migration is
    // confirmed complete.
    match /pos_sales/{month} {
      allow read, write: if isOwner();
      match /branches/{branchId} {
        allow read, write: if isOwner() || (
          signedIn() &&
          exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.branchId == branchId
          )
        );
      }
    }

    // ── AUDIT LOG — one document per entry, truly append-only ──────
    // Any role may CREATE a new entry (cashier actions must be logged too,
    // not just admin's), but update/delete are hard-denied to EVERYONE
    // including admin from the client — no rule can enforce "grow-only" on
    // a single shared array field (see the note in 88-abc-expenses.js), but
    // it can enforce "this specific document may never be modified once
    // created" when each entry is its own document. That's the actual
    // append-only guarantee.
    match /pos_audit/{entryId} {
      // Read is gated by the 'audit' tab permission (see TAB PERMISSIONS
      // above) — but create is NOT: every page in the app logs its own
      // actions here as a side effect (see addAuditLog in 88-abc-expenses.js),
      // so a cashier who can't view the audit log page must still be able to
      // trigger a log entry from whatever page they're legitimately using.
      allow read: if isOwner() || (
        signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        _tabOk(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data, 'audit', 'view')
      );
      allow create: if isOwner() || (
        signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
      );
      allow update, delete: if false;
    }

    // ── STOCK-TAKE RECORDS (تسوية الجرد) — one document per count ──
    // An applied count is an accounting record: what was counted, what the
    // variances were worth at the cost of the day, and who applied it. Kept
    // per-document and immutable for the same reason as pos_audit — a rule can
    // enforce "never changes once written" on a document, but not on entries
    // inside a shared array.
    //
    // ADMIN ONLY. Stock-taking has been an admin-only job by policy since the
    // feature was built — a cashier has no permission for it and cannot even
    // open the inventory tab (_FIXED_ROLE_GRANTS in 00-core.js grants a cashier
    // helpdesk and nothing else). The UI reflects that, but the UI is not a
    // barrier: `inventory` is enforced: false in DEPARTMENTS, so these rules
    // are the only place the policy can actually be enforced.
    //
    // Reads stay branch-scoped rather than admin-only so a branch manager can
    // be shown their own settlements later without reopening this rule.
    match /pos_stocktakes/{takeId} {
      allow read: if isOwner() || (
        signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.branchId == resource.data.branchId
        )
      );
      // A count is issued pending and moves no stock. Counting and approving
      // are two separate acts: the count has to be reviewed, more than once,
      // before anyone acts on it.
      allow create: if (
        isOwner() || (
          signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin'
        )
      ) && request.resource.data.status == 'pending';

      // OWNER ONLY, and only pending -> applied/cancelled. The figures that
      // were counted are pinned: whoever approves is approving the numbers
      // that were reviewed, not a version edited on the way through. items is
      // compared by length rather than element-by-element — a full count can
      // carry thousands of entries and rules have an expression budget — while
      // summary (the money) is compared outright.
      allow update: if isOwner() &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['applied', 'cancelled'] &&
        request.resource.data.summary == resource.data.summary &&
        request.resource.data.items.size() == resource.data.items.size() &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.countedBy == resource.data.countedBy &&
        request.resource.data.countedAt == resource.data.countedAt;

      allow delete: if isOwner();
    }

    // ── PRICE-CHANGE APPROVALS — one document per request ─────────
    // Replaces the shared pos_data/price_approvals document, which could not
    // be secured: a rule gates a whole document, so every account allowed to
    // write that one could set status:'approved' on its own request. The
    // manager-approves-a-discount control lived only in the UI. Same reasoning
    // as pos_audit above — per-document storage is what makes the rule
    // expressible at all.
    //
    // ⚠️ The old pos_data/price_approvals rule is deliberately still in force
    // (it falls under the pos_data block above). Publish THESE rules first,
    // then deploy the client: the client cannot write here until the rules
    // allow it, so the usual client-first order is reversed. Drop the old
    // document once every device is on the new build.
    //
    // Only a role of 'admin' decides — matches the app exactly: the approvals
    // bell renders for currentUser === 'admin' only, and a branch manager is
    // currentUser === 'cashier' with an isBranchManager flag (00-core.js), so
    // managers never approved. 'admin' is a label whose finer permissions come
    // from the tree; gating this on a dedicated permission key instead is a
    // clean follow-up that would touch only this line.
    match /pos_price_approvals/{reqId} {
      allow read: if isOwner() || (
        signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && (
          resource.data.cashierUid == request.auth.uid ||
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin'
        )
      );

      // A request may only ever be born pending, and only in your own name.
      allow create: if signedIn() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.cashierUid == request.auth.uid &&
        // Mandatory from creation, so the only documents that can lack it are
        // the ones written by the previous build — see the transition note on
        // the update rules below.
        request.resource.data.expiresAt is number;

      // The decision — admin only, and NEVER on your own request. items/total
      // are pinned so the prices approved are the prices that were reviewed.
      allow update: if (
        isOwner() || (
          signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin'
        )
      ) &&
        resource.data.cashierUid != request.auth.uid &&
        resource.data.status == 'pending' &&
        // A request nobody answered expires with its day too. Without this,
        // approving a week-old request would put that discount live today —
        // the same stale-approval problem the expiry on approved ones closes.
        request.time.toMillis() < resource.data.expiresAt &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.cashierUid == resource.data.cashierUid &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.total == resource.data.total;

      // Closing out your own approved request. These are the only two
      // self-updates allowed and both only ever reduce what it permits:
      // 'consumed' (the sale committed — completeSale calls this) and
      // 'cancelled' (the customer walked away). Consuming is refused after
      // expiresAt so an approval cannot outlive its business day; cancelling
      // stays allowed afterwards, since that is only tidying up.
      allow update: if signedIn() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        resource.data.cashierUid == request.auth.uid &&
        resource.data.status == 'approved' &&
        request.resource.data.status in ['consumed', 'cancelled'] &&
        (request.resource.data.status == 'cancelled' ||
         request.time.toMillis() < resource.data.expiresAt) &&
        request.resource.data.cashierUid == resource.data.cashierUid &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.total == resource.data.total;

      // Housekeeping: retiring a pending request that ran out its day. Any
      // device that sees a stale one may do this (_expireStaleRequests in
      // 96-approvals.js) so the queue drains itself instead of growing
      // forever — but only AFTER expiresAt, only from 'pending', and only to
      // 'expired', so it can never be used to bury a live request someone is
      // waiting on.
      allow update: if (
        isOwner() || (
          signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && (
            resource.data.cashierUid == request.auth.uid ||
            get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin'
          )
        )
      ) &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'expired' &&
        request.time.toMillis() >= resource.data.expiresAt &&
        request.resource.data.cashierUid == resource.data.cashierUid &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.total == resource.data.total;

      allow delete: if isOwner();
    }

    // ── CHINA PRICING CALCULATOR (سعّرلي / عبد الرازق في الصين) ─────
    // Unrelated side project sharing this Firebase project only because the
    // free tier allows a single project. Fully isolated collection name,
    // no relation to any voodo-erp data. Gated by signedIn() (anonymous
    // auth is enough — this app has no roles/ concept and the data is
    // low-sensitivity reference price lists), just to block casual/bot
    // writes without needing real accounts.
    match /china_pricing_prices/{source} {
      allow read, write: if signedIn();
    }

    // ── Deny everything else ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
