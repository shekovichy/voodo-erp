rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── POS DATA ─────────────────────────────────────────────
    // Only authenticated users (Anonymous Auth from the app) can read/write.
    // "auth" is excluded on purpose: pos_data/auth used to store password
    // hashes and was readable by any anonymously-authenticated client (see
    // CLAUDE.md security notes). The app no longer reads/writes it — block
    // it outright. NOTE: Firestore rules are evaluated as OR across every
    // match block that matches a path, so this exclusion must live INSIDE
    // this rule (a separate `match /pos_data/auth { allow ...: if false }`
    // block would NOT override this wildcard rule, since both would match
    // and the "allow" here would still win).
    //
    // Beyond that, this rule does NOT distinguish admin vs cashier vs branch
    // — anonymous auth means anyone who loads the app has an auth token.
    // Real role-based enforcement requires migrating off the DIY localStorage
    // password system to real Firebase Authentication (email/password +
    // custom claims), which was deliberately deferred — see CLAUDE.md.
    match /pos_data/{document} {
      allow read, write: if request.auth != null && document != 'auth';
    }

    // ── INVENTORY per branch ──────────────────────────────────
    // Firestore rules can't mix a literal prefix with a wildcard inside one
    // path segment (`inv_{branch}` is invalid — a wildcard must occupy the
    // whole segment), so each branch collection is listed explicitly.
    // Keep this list in sync with BRANCH_IDS in src/js/00-core.js.
    match /inv_wh/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /inv_b1/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /inv_b2/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /inv_b3/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /inv_b4/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ── Deny everything else ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
